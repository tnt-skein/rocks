rockspec_format = '3.0'

package = 'tnt-remedy'
version = 'scm-1'

source = {
    url = 'git+https://github.com/tnt-skein/tnt-remedy.git',
    branch = 'main',
}

description = {
    summary = 'Что оператору делать с находками диагностики',
    detailed = [[
        Список из сорока находок бесполезен: человеку нужно не «что
        сломалось», а «какую кнопку нажать» — и с уже подставленными
        аргументами, чтобы не переписывать имена узлов руками в три часа
        ночи.

        remedy.suggest(snapshot, issues) берёт снимок кластера и находки
        диагностики и отдаёт список предложений: действие, узлы или
        репликасеты, к которым его применить, находки-причины и одну строку
        для человека. Семь действий: перечитать конфигурацию, перезапустить
        репликацию, вывести узел из эксплуатации, назначить лидера, поднять
        назначенного лидера силой, включить ребалансировщик, поправить
        объявленный адрес.

        Пакет содержит только предложения: он ничего не выполняет и ничего
        не меняет. Диагностика, меняющая кластер как побочный эффект
        перечисления проблем, превращает сетевой сбой на этапе опроса
        в массовый вывод узлов из кластера.

        Предложение не появляется там, где оно заведомо не поможет:
        перезапуск репликации бессмыслен, пока сосед не отвечает вовсе,
        а перечитывать конфигурацию на молчащем узле некому. Выведенный
        из эксплуатации узел не трогается.

        Зависимостей нет: только то, что встроено в Lua. Покрытие строк
        и убитых мутантов — 100 %.
    ]],
    homepage = 'https://github.com/tnt-skein/tnt-remedy',
    issues_url = 'https://github.com/tnt-skein/tnt-remedy/issues',
    maintainer = 'tnt-skein',
    license = 'MIT',
    labels = { 'tarantool', 'cluster', 'operations', 'diagnostics', 'remediation' },
}

dependencies = {
    'lua >= 5.1',
}

build = {
    type = 'builtin',
    modules = {
        ['tnt.remedy'] = 'tnt/remedy.lua',
    },
}
