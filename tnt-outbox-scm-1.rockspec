rockspec_format = '3.0'

package = 'tnt-outbox'
version = 'scm-1'

source = {
    url = 'git+https://github.com/tnt-skein/tnt-outbox.git',
    branch = 'main',
}

description = {
    summary = 'Ящик исходящих для Tarantool: событие одной транзакцией с данными, отправка отдельно',
    detailed = [[
        «Сохранили и отправили» двумя действиями теряет событие при обрыве
        между ними, и потеря тихая: данные есть, события нет, и узнать
        об этом неоткуда. Ящик делает два действия одним: outbox.write
        кладёт событие строкой спейса в той же транзакции, что и данные,
        откат уносит обоих, фиксация оставляет обоих.

        Отдельный вывоз на узле для записи отправляет строки по порядку
        ключа назначенным отправителем — таблицей с send(name, body, opts),
        которая приходит аргументом настройки, — и удаляет отправленные.
        Отправляется только зафиксированное: отметку ставит box.on_commit
        записи, а лежавшее до запуска открывает барьер поколения, поэтому
        строку транзакции, которая ещё ждёт записи или кворума, вывоз
        не отправит. Опознаватель ULID и заголовки контекста ставит запись,
        и повторная отправка несёт те же. Повторяемый отказ оставляет строку
        на месте и откладывает вывоз растущим отступом, неповторяемый уводит
        её в outbox_dead. Гарантия — хотя бы раз.

        Зависит от tnt-must (проверки аргументов), tnt-clock (время записи
        и планировщика), tnt-context (заголовки контекста), tnt-id
        (опознаватель), tnt-log (журнал), tnt-loop (такт вывоза), tnt-retry
        (отступ после отказа) и tnt-external (подмена транзакции, спейсов
        и часов в проверках). Покрытие строк и убитых мутантов — 100 %.
    ]],
    homepage = 'https://github.com/tnt-skein/tnt-outbox',
    issues_url = 'https://github.com/tnt-skein/tnt-outbox/issues',
    maintainer = 'tnt-skein',
    license = 'MIT',
    labels = { 'tarantool', 'outbox', 'transactional-outbox', 'messaging', 'events', 'at-least-once' },
}

dependencies = {
    'lua >= 5.1',
    -- Проверки настроек, имени назначения и тела на строке вызывающего.
    'tnt-must',
    -- Стенное время записи и время планировщика для отступа.
    'tnt-clock',
    -- Заголовки контекста, которые запись кладёт в строку.
    'tnt-context',
    -- Опознаватель ULID сообщения.
    'tnt-id',
    -- Записи о зарытом, отложенном вывозе и сорвавшемся такте.
    'tnt-log',
    -- Такт вывоза.
    'tnt-loop',
    -- Отступ после повторяемого отказа отправителя.
    'tnt-retry',
    -- Подмена транзакции, спейсов, часов и режима узла в проверках.
    'tnt-external',
}

build = {
    type = 'builtin',
    modules = {
        ['tnt.outbox'] = 'tnt/outbox.lua',
        ['tnt.outbox.commit'] = 'tnt/outbox/commit.lua',
        ['tnt.outbox.message'] = 'tnt/outbox/message.lua',
        ['tnt.outbox.shipper'] = 'tnt/outbox/shipper.lua',
        ['tnt.outbox.space'] = 'tnt/outbox/space.lua',
    },
}
